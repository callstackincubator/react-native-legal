{
  "compilerOptions": {
    "declaration": true,
    "lib": ["es2020", "DOM"],
    "module": "node16",
    "target": "es2020",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",

    "outDir": "build",
    "rootDir": "src",
    "typeRoots": ["../types-definitions", "../../../node_modules/@types"],
    "types": ["node", "xcode"]
  },
  "include": ["./src"],
  "exclude": ["**/__mocks__/*", "**/__tests__/*"]
}
