{
  "name": "@callstack/license-kit-visualizer",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "yarn licenses && next build",
    "licenses": "yarn workspace license-kit dev report --format markdown --output src/app/licenses/licenses.md --transitive-deps-mode all --dev-deps-mode root-only --include-optional-deps --root $(pwd)",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --ignore-pattern \"next-env.d.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "yarn build"
  },
  "dependencies": {
    "@callstack/licenses": "workspace:^",
    "@dagrejs/dagre": "^3.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.0",
    "@mui/material": "^9.1.0",
    "@mui/material-nextjs": "^9.1.0",
    "@uidotdev/usehooks": "^2.4.1",
    "chart.js": "^4.5.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "immer": "^11.1.0",
    "lodash": "^4.18.1",
    "motion": "^12.23.0",
    "next": "^16.2.0",
    "notistack": "^3.0.2",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tss-react": "^4.9.18",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/eslint": "^9.6.1",
    "@types/lodash": "^4.17.18",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "raw-loader": "^4.0.2",
    "typescript": "^5"
  }
}
